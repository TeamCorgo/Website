{
    "files.exclude": {
        "**/venv": true,
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/*.code-workspace": true,
    },
    "editor.formatOnSave": true,
    "editor.rulers": [
        88
    ],
    "editor.fontSize": 18,
    "[python]": {
        "editor.formatOnSaveMode": "file",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
    },
}